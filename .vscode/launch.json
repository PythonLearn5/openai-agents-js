      "name": "Debug example: memory-hitl",
      "cwd": "${workspaceFolder}/examples/memory",
      "program": "${workspaceFolder}/examples/memory/memory-hitl.ts",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug example: research-bot",
      "cwd": "${workspaceFolder}/examples/research-bot",
      "program": "${workspaceFolder}/examples/research-bot/main.ts",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug example: sandbox-basic",
      "cwd": "${workspaceFolder}/examples/sandbox",
      "program": "${workspaceFolder}/examples/sandbox/basic.ts",
      "args": ["--docker"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
